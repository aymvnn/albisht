# ALBISHT × Storyblok — environment
# Copy to .env.local and fill in. Never commit .env.local.

# ── Runtime (Next.js) ───────────────────────────────────────────────
# Master switch. Leave false until the space is populated and pages are
# wired; the site then serves the static lib/ content exactly as before.
NEXT_PUBLIC_USE_STORYBLOK=false

# Storyblok "Preview" delivery token (Space → Settings → Access Tokens).
# Public — safe to expose to the browser.
NEXT_PUBLIC_STORYBLOK_TOKEN=

# Space region: eu | us | ap | ca   (EU recommended for Doha traffic)
NEXT_PUBLIC_STORYBLOK_REGION=eu

# Shared secret for /api/revalidate (any long random string). Used by the
# "Republish ALBISHT" bookmarklet. Keep private.
STORYBLOK_REVALIDATE_SECRET=

# ── Migration only (never shipped to the browser) ───────────────────
# Personal Access Token (Account → Access Tokens → Personal access tokens).
# Grants write access via the Management API. Keep private.
STORYBLOK_OAUTH_TOKEN=

# Numeric Space ID (Space → Settings → General).
STORYBLOK_SPACE_ID=

# Region for the Management API (match the space): eu | us | ap | ca
STORYBLOK_REGION=eu
