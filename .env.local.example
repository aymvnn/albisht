# ALBISHT × Sanity — environment
# Copy to .env.local and fill in. Never commit .env.local.

# Master switch. Leave false until the project exists + content is imported;
# the site then serves the static lib/ content exactly as before.
NEXT_PUBLIC_USE_SANITY=false

# From sanity.io/manage → your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Origin the Studio's Visual Editor previews (dev: http://localhost:3300,
# prod: your Vercel/live URL).
NEXT_PUBLIC_SANITY_PREVIEW_ORIGIN=http://localhost:3300

# Viewer (read) token — used only for draft preview in the Visual Editor.
# Project → API → Tokens → role "Viewer".
SANITY_VIEWER_TOKEN=

# Editor (write) token — used ONLY by the import script (npm run sanity:import).
# Project → API → Tokens → role "Editor". Keep private.
SANITY_WRITE_TOKEN=

# === Site / SEO ==============================================================
# Public origin of the deployed site. Used for canonical URLs, hreflang
# alternates, the sitemap, and Open Graph cards. Leave unset in local dev
# (falls back to http://localhost:3300).
NEXT_PUBLIC_SITE_URL=

# === Consult letter delivery =================================================
# The /api/consult route delivers the letter by email through Resend
# (https://resend.com — free tier suffices). Without a key the route still
# accepts letters and logs them server-side, so the form never breaks.
RESEND_API_KEY=
# Where letters arrive. Defaults to hello@albisht.qa.
CONSULT_TO_EMAIL=
# Verified sender (Resend requires a verified domain or its onboarding
# address). Defaults to onboarding@resend.dev which works without setup.
CONSULT_FROM_EMAIL=
